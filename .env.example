# Database — konteyner host şəbəkəsi ilə 127.0.0.1 yazın (Plesk Postgres local auth).
# Bridge şəbəkədə host.containers.internal və ya gateway IP istifadə olunur.
POSTGRES_USER=autonex
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=autonex
DATABASE_URL=postgresql://autonex:change-this-db-password@localhost:5432/autonex?schema=public

# Redis
REDIS_URL=redis://localhost:6379

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public site — one Next.js port; Nest listens only inside the container
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://127.0.0.1:4000/api/v1
API_PORT=4000
API_HOST=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://nex.autos
CORS_ORIGIN=https://nex.autos
NEXT_PUBLIC_WHATSAPP=994709668111
NEXT_PUBLIC_TELEGRAM=autonex

# First staff user (prisma db seed)
ADMIN_EMAIL=admin@nex.autos
ADMIN_PASSWORD=
ADMIN_NAME=Auto Nex
ADMIN_PHONE=994709668111

# Cloudflare R2 — tracking photos (S3-compatible). Do not commit real keys.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET=nexautos
R2_PUBLIC_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Auto Nex <auto@nex.autos>
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# WhatsApp (Vexira). Twilio / Meta ehtiyat üçündür.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VEXIRA_WHATSAPP_KEY=
VEXIRA_WHATSAPP_URL=https://api.vexirahost.com/api/v1/whatsapp/messages

# OTP kodunu admin/müştəri ekranında göstərmə — production-da false qalsın
CONTRACT_REVEAL_OTP=false
ENABLE_SWAGGER=false

# Live vessel map — optional fallback. Preferred: Admin → Ayarlar (stored in DB).
# https://aisstream.io/apikeys
AISSTREAM_API_KEY=
AIS_API_KEY=
