# Database
POSTGRES_USER=autonex
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=autonex
DATABASE_URL=postgresql://autonex:change-this-db-password@localhost:5432/autonex?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public site — production-da mütləq https domen
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://nex.autos
CORS_ORIGIN=https://nex.autos
NEXT_PUBLIC_WHATSAPP=994709668111
NEXT_PUBLIC_TELEGRAM=autonex

# First staff user (prisma db seed)
ADMIN_EMAIL=admin@nex.autos
ADMIN_PASSWORD=
ADMIN_NAME=Auto Nex
ADMIN_PHONE=994709668111

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autonex
R2_PUBLIC_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Auto Nex <auto@nex.autos>
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# WhatsApp (Vexira). Twilio / Meta ehtiyat üçündür.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VEXIRA_WHATSAPP_KEY=
VEXIRA_WHATSAPP_URL=https://api.vexirahost.com/api/v1/whatsapp/messages

# OTP kodunu admin/müştəri ekranında göstərmə — production-da false qalsın
CONTRACT_REVEAL_OTP=false
ENABLE_SWAGGER=false

# Live container / vessel (optional)
SEARATES_API_KEY=
SHIPSGO_API_KEY=
AISSTREAM_API_KEY=
AIS_API_KEY=
