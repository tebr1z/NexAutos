{
  "manifest_version": 3,
  "name": "Auto Nex – BidCars Kalkulyatoru",
  "version": "1.9.9",
  "description": "BidCars ümumi qiymətini hesablayır və Caucasus Auto-dan Copart/IAAI yol tariflərini toplayır.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://nex.autos/*",
    "https://login.caucasusauto.com/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BidCars səhifəsini Auto Nex ilə hesabla"
  },
  "content_scripts": [
    {
      "matches": ["https://bid.cars/*", "https://www.bid.cars/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://login.caucasusauto.com/admin.php*"],
      "js": ["caucasus.js"],
      "run_at": "document_idle"
    }
  ]
}
